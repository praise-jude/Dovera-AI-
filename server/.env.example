# Postgres connection string. On Railway, reference the Postgres plugin's
# variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/vidora

# Long random string used to sign auth tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of origins allowed to call this API (your frontend
# URL(s)). Leave unset in development to allow all origins.
CORS_ORIGIN=https://dovera-ai-production.up.railway.app

# Where uploaded/generated files are written. On Railway, mount a volume and
# point this at its mount path so files survive redeploys.
STORAGE_DIR=./data

# --- Optional AI provider keys -------------------------------------------
# Leave unset to keep those capabilities in "not configured" state — the
# API reports this via GET /providers rather than faking a result.
RUNWAY_API_KEY=
LUMA_API_KEY=
ELEVENLABS_API_KEY=
MUBERT_API_KEY=
