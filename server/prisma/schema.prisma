generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PREMIUM
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ProjectStatus {
  DRAFT
  READY
  NEEDS_REVIEW
  ARCHIVED
}

enum AssetKind {
  IMAGE
  AUDIO
  VIDEO
}

enum AssetCategory {
  MUSIC
  SFX
  VOICE
  AMBIENCE
  OTHER
}

enum JobType {
  SLIDESHOW_VIDEO
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  VOICEOVER
  AI_MUSIC
}

enum JobStatus {
  QUEUED
  ANALYZING
  GENERATING
  PROCESSING
  ADDING_AUDIO
  RENDERING
  EXPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProviderCapability {
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  VOICE
  MUSIC
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  plan         Plan      @default(FREE)
  credits      Int       @default(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subscriptionStatus   SubscriptionStatus @default(NONE)
  paystackCustomerCode String?
  subscriptionCode     String?
  subscriptionEmailToken String?
  planRenewsAt         DateTime?

  projects Project[]
  assets   Asset[]
  payments Payment[]
}

model Payment {
  id         String   @id @default(cuid())
  userId     String
  reference  String   @unique
  amountKobo Int
  currency   String   @default("NGN")
  status     String   @default("pending")
  purpose    String   @default("subscription")
  raw        Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id        String        @id @default(cuid())
  userId    String
  name      String
  status    ProjectStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets Asset[]
  jobs   Job[]

  @@index([userId])
}

model Asset {
  id          String        @id @default(cuid())
  userId      String
  projectId   String?
  kind        AssetKind
  category    AssetCategory @default(OTHER)
  favorite    Boolean       @default(false)
  filename    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  durationSec Float?
  createdAt   DateTime      @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  resultOfJobs Job[] @relation("JobResultAsset")

  @@index([userId])
  @@index([projectId])
}

model Job {
  id                String    @id @default(cuid())
  projectId         String
  type              JobType
  status            JobStatus @default(QUEUED)
  progress          Int       @default(0)
  provider          String
  statusMessage     String?
  error             String?
  params            Json
  creditsEstimated  Int       @default(0)
  creditsCharged    Int       @default(0)
  resultAssetId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  resultAsset Asset?  @relation("JobResultAsset", fields: [resultAssetId], references: [id])

  @@index([projectId])
}

model ProviderConfig {
  id         String             @id @default(cuid())
  capability ProviderCapability
  name       String
  configured Boolean            @default(false)
  notes      String?

  @@unique([capability, name])
}
